# Copy to .env (never commit it) and fill in. Feed addresses are the "export calendar" links from each listing.
PORT=8787
ADMIN_TOKEN=            # long random string; the owner dashboard sends it as a Bearer token
ICAL_TOKEN=             # long random string; goes on the calendar address you give Airbnb and Booking.com
ALLOWED_ORIGINS=https://lutton-homes.vercel.app
SYNC_MINUTES=15
TRUST_PROXY=0           # set to 1 only when a proxy in front sets X-Forwarded-For
FEED_AIRBNB_EASYSTAY=
FEED_BOOKING_EASYSTAY=
FEED_AIRBNB_LUTON_LODGE=
FEED_BOOKING_LUTON_LODGE=
FEED_AIRBNB_EASYSTAY_STUDIO=
FEED_BOOKING_EASYSTAY_STUDIO=
FEED_AIRBNB_THE_GARDEN_STUDIO=
FEED_BOOKING_THE_GARDEN_STUDIO=
FEED_AIRBNB_THE_GARDEN_NEST=
FEED_BOOKING_THE_GARDEN_NEST=
