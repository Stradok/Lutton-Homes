# Copy to .env (never commit it) and fill in. Feed addresses are the "export calendar" links from each listing.
PORT=8787
ADMIN_TOKEN=            # optional service token for scripts; owners sign in with OWNERS below
OWNERS=                 # owner accounts "name:hash,name:hash"; make a hash with: npm run hash-password -- 'the password'
SESSION_SECRET=         # long random string; signs owner sign-in sessions (12 hours)
SITE_URL=https://lutton-homes.vercel.app   # where the payment provider sends guests back to
HOLD_MINUTES=30         # how long an unpaid request holds its nights
PAYMENT_PROVIDER=manual # manual = owner confirms by hand; see src/payments.js to plug in Stripe, PayPal or Square
MAIL_PROVIDER=log       # log = nothing is emailed; see src/notify.js to plug in SMTP, Postmark, Resend
OWNER_EMAIL=            # gets a copy of every booking event
ICAL_TOKEN=             # long random string; goes on the calendar address you give Airbnb and Booking.com
ALLOWED_ORIGINS=https://lutton-homes.vercel.app
SYNC_MINUTES=15
TRUST_PROXY=0           # set to 1 only when a proxy in front sets X-Forwarded-For
FEED_AIRBNB_EASYSTAY=
FEED_BOOKING_EASYSTAY=
FEED_AIRBNB_LUTON_LODGE=
FEED_BOOKING_LUTON_LODGE=
FEED_AIRBNB_EASYSTAY_STUDIO=
FEED_BOOKING_EASYSTAY_STUDIO=
FEED_AIRBNB_THE_GARDEN_STUDIO=
FEED_BOOKING_THE_GARDEN_STUDIO=
FEED_AIRBNB_THE_GARDEN_NEST=
FEED_BOOKING_THE_GARDEN_NEST=
